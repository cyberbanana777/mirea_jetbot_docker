# Домен ROS: должен совпадать с ноутбуком
ROS_DOMAIN_ID=0
# runc по умолчанию; nvidia — если контейнеру нужна CUDA
DOCKER_RUNTIME=runc
# 1 — добавить в образ Nav2 и slam-toolbox (на роботе обычно не нужны)
WITH_NAV2=0
# Потоков сборки (на Nano с 4 ГБ ОЗУ — 2)
BUILD_JOBS=2
# UID/GID пользователя на хосте (проверь командой id)
USER_UID=1000
USER_GID=1000
# Для сервиса bringup: включить камеру RealSense (True/False)
ENABLE_CAMERA=False
